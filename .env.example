# ─────────────────────────────────────────────────────────────────────────────
# Evonic — Docker Deployment Environment Variables
# Copy to .env and fill in your values.
# These override the defaults in config.py.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server Binding ─────────────────────────────────────────────────────────
HOST=0.0.0.0          # Bind all interfaces (required for container access)
PORT=8080             # Main web dashboard port
CONNECTOR_WS_PORT=8081

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=            # Auto-generated if blank; set a strong random value:
                       #   python -c "import secrets; print(secrets.token_hex(32))"

# ── LLM Provider ────────────────────────────────────────────────────────────
# Option 1: OpenAI-compatible endpoint (OpenRouter, Groq, custom, etc.)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o
# LLM_API_KEY=sk-...

# Option 2: HCNSEC (your current setup)
LLM_BASE_URL=https://api.hcnsec.cn/v1
LLM_MODEL_NAME=Qwen3.8-Flash-Next
LLM_API_KEY=                       # Fill in your API key

# ── Sandbox — CONTAINER SAFETY ───────────────────────────────────────────────
# DEFAULT IS SAFE: sandbox_enabled=0 means bash/runpy tools execute
# directly in the container (no Docker-in-Docker needed).
#
# If you set sandbox_enabled=1 and SANDBOX_BACKEND=docker:
#   → REQUIRES docker.sock mount (only works on VM-type hosts, not managed).
#   → Docker Agentic Platform does NOT provide docker.sock.
#
# Safe options for managed containers:
#   SANDBOX_BACKEND=bwrap   # lightweight namespace sandbox (needs bubblewrap)
#   sandbox_enabled=0        # no sandbox, tools run locally (simplest, safest)

SANDBOX_BACKEND=bwrap
SANDBOX_WORKSPACE=/home/evonic
SANDBOX_IDLE_TIMEOUT=3600
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
SANDBOX_NETWORK=bridge
SANDBOX_MAX_CONTAINERS=5
SANDBOX_BWRAP_ULIMIT_V_MB=256

# ── Database ──────────────────────────────────────────────────────────────────
# DB lives at /home/evonic/shared/db/evonic.db (auto-created)
# Mount a volume at SHARED_DB_DIR for persistence across restarts:
#   -v evonic-db:/home/evonic/shared/db
SHARED_DB_DIR=/home/evonic/shared

# ── Evonet (Tunnel Workplace) ────────────────────────────────────────────────
# CONNECTOR_WS_HOST and CONNECTOR_WS_PORT already set above.
# Evonet is optional — for local/Docker deploy, keep it disabled unless you
# have a Cloudflare tunnel or reverse proxy set up externally.
EVONET_ENABLED=0

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/home/evonic/logs

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AGENT_STATE=1
ARTIFACTS_ENABLED=1
ATTACHMENTS_ENABLED=1
VISION_ENABLED=1

# ── HMADS Safety (Heuristic Mal-Activity Detection) ─────────────────────────
HMADS_SAFE_THRESHOLD=3
HMADS_WARNING_THRESHOLD=7
HMADS_APPROVAL_THRESHOLD=14

# ── Pairing Code ─────────────────────────────────────────────────────────────
PAIRING_CODE_EXPIRY_MINUTES=5
